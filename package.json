    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "node --test tests/*.test.ts",
    "tokens:generate": "node scripts/tokens.mjs",
    "tokens:check": "node scripts/tokens.mjs --check",
    "build:web": "expo export --platform web"
