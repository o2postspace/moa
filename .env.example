# 이 파일을 .env.local로 복사하고 비밀값은 그 파일에만 입력하세요.
# 웹 개발 미리보기 전용. localhost와 127.0.0.1을 섞어 쓰지 마세요.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787
APP_ORIGIN=http://localhost:8081
API_PORT=8787
GOOGLE_REDIRECT_URI=http://localhost:8787/api/youtube/callback

# 서버 전용. EXPO_PUBLIC_ 접두사를 붙이면 앱 번들에 노출됩니다.
# OAuth 웹 클라이언트와 YouTube Data API v3를 설정합니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=

# 서버 전용 지역 검색 제공자. 선택한 경로의 키만 사용하며 자동 대체하지 않습니다.
# 기존 발급 키는 legacy, 신규 NAVER API HUB 키는 hub를 선택합니다. NCP Maps 키와 다릅니다.
NAVER_API_PROVIDER=legacy

# legacy: 기존 NAVER 개발자센터 검색 API 인증 정보
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# hub: NAVER API HUB Application에서 발급한 검색 API 인증 정보
NAVER_HUB_CLIENT_ID=
NAVER_HUB_CLIENT_SECRET=
